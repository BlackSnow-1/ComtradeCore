@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(UNIX)
    find_dependency(Iconv)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ComtradeCoreTargets.cmake")
if("AI" IN_LIST ComtradeCore_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ComtradeAITargets.cmake")
        find_dependency(nlohmann_json 3.12)
        find_dependency(OpenSSL 3.0)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/ComtradeAITargets.cmake")
        set(ComtradeCore_AI_FOUND TRUE)
    else()
        set(ComtradeCore_AI_FOUND FALSE)
    endif()
endif()

check_required_components(ComtradeCore)
