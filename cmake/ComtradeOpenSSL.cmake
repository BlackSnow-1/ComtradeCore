# Prefer the developer's installation. Build the pinned official source only as a fallback.
include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
option(COMTRADE_FETCH_OPENSSL "Build OpenSSL from official GitHub sources when not installed" ON)
option(COMTRADE_FORCE_FETCH_OPENSSL "Exercise the source fallback even if OpenSSL is installed" OFF)
set(COMTRADE_OPENSSL_JOBS 2 CACHE STRING "Parallel jobs for the OpenSSL source build")
if(NOT COMTRADE_FORCE_FETCH_OPENSSL)
    find_package(OpenSSL 3.0 QUIET COMPONENTS Crypto SSL)
endif()
set(COMTRADE_AI_OPENSSL_FETCHED OFF)
if(OPENSSL_FOUND AND NOT COMTRADE_FORCE_FETCH_OPENSSL AND
   (NOT COMTRADE_FETCH_OPENSSL OR
    (NOT OPENSSL_ROOT_DIR STREQUAL "${FETCHCONTENT_BASE_DIR}/ai_openssl-build/install" AND
     (NOT COMTRADE_BUILT_OPENSSL_ROOT OR NOT OPENSSL_ROOT_DIR STREQUAL COMTRADE_BUILT_OPENSSL_ROOT))))
    message(STATUS "ComtradeCore AI: found local OpenSSL ${OPENSSL_VERSION}, using it.")
    return()
endif()
if(NOT COMTRADE_FETCH_OPENSSL)
    message(FATAL_ERROR "OpenSSL >= 3.0 development files not found. Set OPENSSL_ROOT_DIR or enable COMTRADE_FETCH_OPENSSL.")
endif()
if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "OpenSSL automatic source build requires a native build. Supply the target OpenSSL with OPENSSL_ROOT_DIR.")
endif()
if(NOT COMTRADE_OPENSSL_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "COMTRADE_OPENSSL_JOBS must be a positive integer")
endif()
find_package(Perl REQUIRED)
# OpenSSL bundles Text::Template, so only IPC::Cmd must be provided by Perl itself.
execute_process(COMMAND "${PERL_EXECUTABLE}" -MIPC::Cmd -e 1
    RESULT_VARIABLE _openssl_perl_result OUTPUT_QUIET ERROR_VARIABLE _openssl_perl_error)
if(NOT _openssl_perl_result STREQUAL "0")
    message(FATAL_ERROR "The selected Perl cannot load IPC::Cmd: ${_openssl_perl_error}. Install a complete Perl (Windows: Strawberry Perl), set PERL_EXECUTABLE, or provide OPENSSL_ROOT_DIR.")
endif()
enable_language(C)
if(MSVC)
    find_program(COMTRADE_OPENSSL_MAKE NAMES nmake REQUIRED)
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_openssl_target VC-WIN64A)
    else()
        set(_openssl_target VC-WIN32)
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM|arm|aarch")
        message(FATAL_ERROR "For Windows ARM, provide OpenSSL with OPENSSL_ROOT_DIR.")
    endif()
    set(_openssl_parallel)
elseif(MINGW)
    find_program(COMTRADE_OPENSSL_MAKE NAMES mingw32-make REQUIRED)
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_openssl_target mingw64)
    else()
        set(_openssl_target mingw)
    endif()
    set(_openssl_parallel -j${COMTRADE_OPENSSL_JOBS})
elseif(UNIX)
    find_program(COMTRADE_OPENSSL_MAKE NAMES gmake make REQUIRED)
    set(_openssl_target) # Official Configure detects the native Unix target.
    set(_openssl_parallel -j${COMTRADE_OPENSSL_JOBS})
else()
    message(FATAL_ERROR "Unsupported OpenSSL source-build platform; set OPENSSL_ROOT_DIR.")
endif()
message(STATUS "ComtradeCore AI: local OpenSSL >= 3.0 not found (or fallback forced). Fetching/building official OpenSSL 3.5.9; this may take several minutes.")
FetchContent_Declare(ai_openssl
    URL https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz
    URL_HASH SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
    DOWNLOAD_NO_PROGRESS OFF
    TIMEOUT 300)
FetchContent_MakeAvailable(ai_openssl)
file(MAKE_DIRECTORY "${ai_openssl_BINARY_DIR}")
set(_openssl_prefix "${ai_openssl_BINARY_DIR}/install")
if(UNIX)
    set(_openssl_default_conf /etc/ssl)
else()
    set(_openssl_default_conf "${_openssl_prefix}/ssl")
endif()
set(COMTRADE_OPENSSL_CONF_DIR "${_openssl_default_conf}" CACHE PATH "OpenSSL default certificate/configuration directory")
set(_openssl_stamp "${ai_openssl_BINARY_DIR}/comtrade-built.txt")
set(_openssl_identity "3.5.9|${CMAKE_C_COMPILER}|${CMAKE_C_COMPILER_VERSION}|${_openssl_target}|${CMAKE_MSVC_RUNTIME_LIBRARY}|${COMTRADE_OPENSSL_CONF_DIR}")
set(_openssl_previous "")
if(EXISTS "${_openssl_stamp}")
    file(READ "${_openssl_stamp}" _openssl_previous)
endif()
function(_comtrade_openssl_step name)
    set(log "${ai_openssl_BINARY_DIR}/${name}.log")
    message(STATUS "ComtradeCore OpenSSL: ${name} (log: ${log})")
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${ai_openssl_BINARY_DIR}"
        RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}" TIMEOUT 1200)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "OpenSSL ${name} failed (${result}). See ${log}. Install OpenSSL development files or set OPENSSL_ROOT_DIR to use a local copy.")
    endif()
endfunction()
if(NOT _openssl_previous STREQUAL _openssl_identity OR NOT EXISTS "${_openssl_prefix}/include/openssl/ssl.h")
    _comtrade_openssl_step(configure ${CMAKE_COMMAND} -E env "CC=${CMAKE_C_COMPILER}"
        ${PERL_EXECUTABLE} "${ai_openssl_SOURCE_DIR}/Configure" ${_openssl_target}
        no-shared no-module no-tests no-asm "--prefix=${_openssl_prefix}" "--openssldir=${COMTRADE_OPENSSL_CONF_DIR}" --libdir=lib)
    _comtrade_openssl_step(build ${COMTRADE_OPENSSL_MAKE} ${_openssl_parallel})
    _comtrade_openssl_step(install ${COMTRADE_OPENSSL_MAKE} install_sw)
    file(WRITE "${_openssl_stamp}" "${_openssl_identity}")
endif()
# Clear unsuccessful or old cache lookups before resolving the private installation.
unset(OPENSSL_INCLUDE_DIR CACHE)
unset(OPENSSL_CRYPTO_LIBRARY CACHE)
unset(OPENSSL_SSL_LIBRARY CACHE)
unset(LIB_EAY CACHE)
unset(SSL_EAY CACHE)
set(OPENSSL_ROOT_DIR "${_openssl_prefix}" CACHE PATH "OpenSSL installation" FORCE)
set(OPENSSL_USE_STATIC_LIBS TRUE CACHE BOOL "Use static OpenSSL" FORCE)
find_package(OpenSSL 3.0 REQUIRED COMPONENTS Crypto SSL)
set(COMTRADE_AI_OPENSSL_FETCHED ON)
set(COMTRADE_BUILT_OPENSSL_ROOT "${_openssl_prefix}" CACHE INTERNAL "Project-built OpenSSL installation")
# Package the fallback's development files; installed consumers can discover them under their prefix.
if(COMTRADE_INSTALL_AI)
    install(DIRECTORY "${_openssl_prefix}/include/openssl" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
    install(DIRECTORY "${_openssl_prefix}/lib/" DESTINATION ${CMAKE_INSTALL_LIBDIR}
        FILES_MATCHING PATTERN "*.a" PATTERN "*.lib" PATTERN "pkgconfig" EXCLUDE)
    install(FILES "${ai_openssl_SOURCE_DIR}/LICENSE.txt"
        DESTINATION ${CMAKE_INSTALL_DATAROOTDIR}/doc/ComtradeCore/licenses RENAME OpenSSL.txt)
endif()
